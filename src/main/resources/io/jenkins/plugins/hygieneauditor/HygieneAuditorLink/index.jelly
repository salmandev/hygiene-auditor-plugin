<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${%Hygiene Auditor}" type="one-column" permission="${it.requiredPermission}">
    <st:adjunct includes="io.jenkins.plugins.hygieneauditor.style"/>
    <l:main-panel>
      <j:set var="summary" value="${it.summary}"/>
      <l:app-bar title="${%Hygiene Auditor}">
        <j:if test="${it.canConfigure}">
          <a href="${rootURL}/manage/configure" class="jenkins-button">${%Settings}</a>
        </j:if>
      </l:app-bar>

      <p>${%Read-only report of what is likely unused. Every finding states its evidence and how confident the auditor is; nothing here is ever deleted or changed automatically.}</p>

      <div class="ha-toolbar">
        <j:if test="${it.canScan}">
          <j:choose>
            <j:when test="${summary.scanRunning}">
              <f:form method="post" action="cancel" name="cancel">
                <input type="hidden" name="fromUi" value="true"/>
                <button type="submit" class="jenkins-button jenkins-!-destructive-color">${%Cancel scan}</button>
              </f:form>
            </j:when>
            <j:otherwise>
              <f:form method="post" action="scan" name="scan">
                <input type="hidden" name="fromUi" value="true"/>
                <button type="submit" class="jenkins-button jenkins-button--primary">${%Scan now}</button>
              </f:form>
            </j:otherwise>
          </j:choose>
        </j:if>
      </div>

      <div class="ha-status" role="status">
        <j:choose>
          <j:when test="${summary.scanRunning}">
            <j:set var="run" value="${it.runningScan.get()}"/>
            <strong>${%A scan is running.}</strong>
            <j:forEach var="e" items="${run.itemsExamined().entrySet()}"> ${e.key}: ${e.value}</j:forEach>
          </j:when>
          <j:when test="${summary.lastScanEnd != null}">
            ${%Last scan}: <time datetime="${summary.lastScanEnd}">${summary.lastScanEnd}</time> (${summary.lastScanState})
            <j:forEach var="c" items="${summary.lastScanCollectors}">
              <br/>${c.collector}: ${c.status}, ${c.items} ${%items}, ${c.findings} ${%findings}<j:if test="${c.message != null}"> — ${c.message}</j:if>
            </j:forEach>
          </j:when>
          <j:otherwise>${%No scan has run yet.}</j:otherwise>
        </j:choose>
      </div>

      <h2>${%Open findings}</h2>
      <div class="ha-cards">
        <section class="ha-card" aria-labelledby="ha-h-cat">
          <h3 id="ha-h-cat">${%By category}</h3>
          <dl><j:forEach var="e" items="${summary.openByCategory.entrySet()}"><dt>${it.categoryLabel(e.key)}</dt><dd>${e.value}</dd></j:forEach></dl>
        </section>
        <section class="ha-card" aria-labelledby="ha-h-sev">
          <h3 id="ha-h-sev">${%By severity}</h3>
          <dl><j:forEach var="e" items="${summary.openBySeverity.entrySet()}"><dt>${it.severityLabel(e.key)}</dt><dd>${e.value}</dd></j:forEach></dl>
        </section>
        <section class="ha-card" aria-labelledby="ha-h-conf">
          <h3 id="ha-h-conf">${%By confidence}</h3>
          <dl><j:forEach var="e" items="${summary.openByConfidence.entrySet()}"><dt>${it.confidenceLabel(e.key)}</dt><dd>${e.value}</dd></j:forEach></dl>
        </section>
        <section class="ha-card" aria-labelledby="ha-h-st">
          <h3 id="ha-h-st">${%By status}</h3>
          <dl><j:forEach var="e" items="${summary.byStatus.entrySet()}"><dt>${it.statusLabel(e.key)}</dt><dd>${e.value}</dd></j:forEach></dl>
        </section>
      </div>

      <h2>${%Trend}</h2>
      <j:choose>
        <j:when test="${!it.trendVisible}"><p class="ha-empty">${%The trend covers the whole instance and is shown to administrators only.}</p></j:when>
        <j:otherwise>
          <j:set var="svg" value="${it.trendSvg}"/>
          <j:choose>
            <j:when test="${empty(svg)}"><p class="ha-empty">${%The trend appears after at least two scans.}</p></j:when>
            <j:otherwise><j:out value="${svg}"/></j:otherwise>
          </j:choose>
        </j:otherwise>
      </j:choose>

      <h2>${%Findings}</h2>
      <st:include it="${it.panel}" page="table.jelly"/>

      <h2>${%Export and removal plan}</h2>
      <p>${%Downloads use the filter above. A removal plan is a script or checklist for you to review and run yourself; it only lists findings with high confidence by default and never runs anything.}</p>
      <div class="ha-toolbar">
        <a class="jenkins-button" href="exportCsv?${it.panel.exportQuery}">${%Download CSV}</a>
        <a class="jenkins-button" href="exportJson?${it.panel.exportQuery}">${%Download JSON}</a>
        <a class="jenkins-button" href="removalPlan?format=groovy">${%Removal plan (Groovy)}</a>
        <a class="jenkins-button" href="removalPlan?format=cli">${%Removal plan (shell)}</a>
        <a class="jenkins-button" href="removalPlan?format=checklist">${%Removal plan (checklist)}</a>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
