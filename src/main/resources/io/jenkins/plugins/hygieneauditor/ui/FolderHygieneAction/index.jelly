<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="${%Hygiene Auditor}" type="one-column">
    <st:adjunct includes="io.jenkins.plugins.hygieneauditor.style"/>
    <l:main-panel>
      <l:app-bar title="${%Hygiene Auditor}: ${it.folder.fullDisplayName}"/>
      <p>${%Findings for this folder, limited to what you are allowed to see. Read-only.}</p>
      <st:include it="${it.panel}" page="table.jelly"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
