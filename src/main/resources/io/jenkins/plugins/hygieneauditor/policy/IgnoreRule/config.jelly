<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Category}" field="category"><f:select/></f:entry>
  <f:entry title="${%Finding type}" field="type"><f:textbox/></f:entry>
  <f:entry title="${%Subject regex}" field="subject"><f:textbox/></f:entry>
  <f:entry title="${%Folder}" field="folder"><f:textbox/></f:entry>
  <f:entry title="${%Reason}" field="reason"><f:textbox/></f:entry>
</j:jelly>
