<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:f="/lib/form">
  <l:layout title="${it.subjectDisplayName}" type="one-column">
    <st:adjunct includes="io.jenkins.plugins.hygieneauditor.style"/>
    <l:main-panel>
      <div class="ha-page">
        <header class="ha-detail-top">
          <div>
            <div class="ha-detail-title">
              <h1 class="ha-mono">${it.subjectDisplayName}</h1>
              <span class="ha-pill ha-conf-${it.confidence.toLowerCase()}">${it.confidenceLabel} ${%confidence}</span>
              <span class="ha-sev ha-sev-${it.severity.toLowerCase()}">${it.severityLabel} ${%severity}</span>
              <span class="ha-status ha-status-${it.status.toLowerCase()}">${it.statusLabel}<j:if test="${it.statusReason != null}"> <span class="ha-sep">—</span> ${it.statusReason}</j:if><j:if test="${it.snoozeUntil != null}"> (${%until} ${it.snoozeUntil})</j:if></span>
            </div>
          </div>
        </header>

        <div class="ha-detail-grid">
          <div>
            <section class="ha-card">
              <dl class="ha-facts">
                <div><dt>${%Finding}</dt><dd title="${it.type}">${it.typeLabel}</dd></div>
                <div><dt>${%Category}</dt><dd>${it.categoryLabel}</dd></div>
                <div><dt>${%Subject}</dt><dd>${it.subject}</dd></div>
                <div><dt>${%First seen}</dt><dd><time datetime="${it.firstSeen}" title="${it.firstSeen}">${it.firstSeenShort}</time> <span class="ha-sep">·</span><span class="ha-muted">${it.firstSeenAgo}</span></dd></div>
                <div><dt>${%Last seen}</dt><dd><time datetime="${it.lastSeen}" title="${it.lastSeen}">${it.lastSeenShort}</time> <span class="ha-sep">·</span><span class="ha-muted">${it.lastSeenAgo}</span></dd></div>
              </dl>
              <j:choose>
                <j:when test="${it.status == 'IGNORED' or it.status == 'ACKNOWLEDGED'}">
                  <div class="ha-callout ha-decision ha-decision-${it.status.toLowerCase()}" role="status">
                    <strong class="ha-decision-title"><j:choose><j:when test="${it.status == 'IGNORED'}">${%This finding is ignored}</j:when><j:otherwise>${%This finding is acknowledged}</j:otherwise></j:choose></strong>
                    <j:if test="${it.statusReason != null}"><br/>${it.statusReason}</j:if>
                    <j:if test="${it.snoozeUntil != null}"><br/><span class="ha-muted">${%Snoozed until} ${it.snoozeUntil}</span></j:if>
                    <br/><span class="ha-muted">${%No action is needed. Change the decision on the right to review this finding again.}</span>
                  </div>
                </j:when>
                <j:otherwise>
                  <div class="ha-callout"><strong>${%Suggested action}</strong><br/>${it.suggestedAction}</div>
                </j:otherwise>
              </j:choose>
              <j:if test="${it.subjectPath != null}">
                <div class="ha-linkrow"><a class="jenkins-button" href="${rootURL}/${it.subjectPath}" target="_blank" rel="noopener">${it.subjectLinkLabel} ↗</a>
                <span class="ha-muted">${%Jenkins asks you to confirm there. This plugin never deletes anything.}</span></div>
              </j:if>
            </section>

            <h2 class="ha-section-title">${%Evidence}</h2>
            <p class="ha-muted">${%Positive weights support the conclusion that the subject is unused; zero is informational. Confidence is computed from these weights and lowered by every caveat listed.}</p>
            <section class="ha-card ha-scroll">
              <table class="ha-table">
                <caption class="ha-table-caption">${%Evidence behind this finding}</caption>
                <thead><tr><th scope="col">${%Weight}</th><th scope="col">${%Observation}</th><th scope="col" class="ha-hide-sm">${%Source}</th></tr></thead>
                <tbody>
                  <j:forEach var="e" items="${it.evidence}">
                    <tr>
                      <td><span class="ha-weight ${e.weight gt 0 ? 'ha-weight-pos' : (e.weight lt 0 ? 'ha-weight-neg' : '')}">${e.weight gt 0 ? '+' : ''}${e.weight}</span></td>
                      <td>${e.text}</td>
                      <td class="ha-hide-sm ha-muted">${e.source}</td>
                    </tr>
                  </j:forEach>
                </tbody>
              </table>
            </section>
          </div>

          <aside class="ha-side">
            <section class="ha-card ha-panel">
              <h3>${%How sure are we?}</h3>
              <p class="ha-note">${it.confidenceNote}</p>
            </section>
            <j:if test="${it.statusAction != null}">
              <section class="ha-card">
                <div class="ha-panel"><h3>${%Decision}</h3></div>
                <f:form method="post" action="${it.statusAction}" name="status">
                  <input type="hidden" name="id" value="${it.id}"/>
                  <input type="hidden" name="fromUi" value="true"/>
                  <div class="ha-form">
                    <div>
                      <label for="ha-s-status">${%Set status}</label>
                      <div class="jenkins-select">
                        <select class="jenkins-select__input" id="ha-s-status" name="status">
                        <option value="OPEN" selected="${it.status == 'OPEN' ? 'true' : null}">${%Open}</option>
                        <option value="ACKNOWLEDGED" selected="${it.status == 'ACKNOWLEDGED' ? 'true' : null}">${%Acknowledged}</option>
                        <option value="IGNORED" selected="${it.status == 'IGNORED' ? 'true' : null}">${%Ignored}</option>
                      </select>
                      </div>
                    </div>
                    <div>
                      <label for="ha-s-reason">${%Reason}</label>
                      <input id="ha-s-reason" name="reason" type="text" class="jenkins-input" maxlength="500" aria-describedby="ha-s-reason-hint"/>
                      <small id="ha-s-reason-hint" class="ha-muted">${%Required when ignoring.}</small>
                    </div>
                    <div>
                      <label for="ha-s-snooze">${%Snooze days}</label>
                      <input id="ha-s-snooze" name="snoozeDays" type="number" class="jenkins-input" min="1"/>
                    </div>
                    <div><button type="submit" class="jenkins-button jenkins-button--primary">${%Update status}</button></div>
                  </div>
                </f:form>
              </section>
            </j:if>
          </aside>
        </div>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
